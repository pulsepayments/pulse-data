{
  // Cloudflare Worker that serves the static site from dist/ (built by build.sh).
  // "name" must match the project name in the Cloudflare dashboard.
  "name": "pulse-data",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist"
  },
  // Attach the custom domain. pulsepayments.co is on this Cloudflare account,
  // so deploying creates the DNS record and HTTPS certificate automatically.
  "routes": [
    { "pattern": "data.pulsepayments.co", "custom_domain": true }
  ]
}
